{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leifj/wmp/schema/methods/resolve-response.json",
  "title": "wmp.resolve — Response",
  "description": "Response to a resolve request.",
  "type": "object",
  "required": ["jsonrpc", "id", "result"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["string", "integer"] },
    "result": {
      "type": "object",
      "required": ["wmp", "type", "uri", "metadata"],
      "properties": {
        "wmp": { "$ref": "../wmp-metadata.json" },
        "type": { "type": "string" },
        "uri": { "type": "string" },
        "metadata": {
          "description": "Resolved metadata; null if the resolver determined that the identifier is unknown. For type vctm: an object with vct and, optionally, name, description, display, claims and schema (WMP Core 5.8.1)."
        },
        "trust_info": {
          "type": "object",
          "properties": {
            "trusted": { "type": "boolean" },
            "source": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "vctm" } }, "required": ["type"] },
          "then": {
            "properties": {
              "metadata": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["vct"],
                    "properties": {
                      "vct": { "type": "string", "minLength": 1 },
                      "name": { "type": "string" },
                      "description": { "type": "string" },
                      "display": {},
                      "claims": {},
                      "schema": {}
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
